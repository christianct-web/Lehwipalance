# Production settings for docker-compose.prod.yml.
# Copy to .env in the repo root on the VPS and fill in. Never commit .env.

# ---- Site ----
# The domain whose DNS A record points at this VPS. Caddy gets HTTPS for it.
DOMAIN=tickets.example.tt
# Let's Encrypt account email (expiry warnings go here).
ACME_EMAIL=you@example.com
# Public address of the site, used in ticket links and emails.
PUBLIC_BASE_URL=https://tickets.example.tt
CORS_ORIGINS=https://tickets.example.tt

# ---- Security ----
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Promoter sessions last this long before signing in again (minutes).
JWT_EXPIRES_MINUTES=720

# ---- Database ----
# Supabase: Project Settings > Database > Connection string > "Session pooler"
# (IPv4-friendly, port 5432). Change the scheme to postgresql+psycopg and keep sslmode.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Or Postgres on the VPS (run compose with --profile localdb):
# DATABASE_URL=postgresql+psycopg://lehwi:CHANGE_ME@db:5432/lehwi
# LOCALDB_PASSWORD=CHANGE_ME

# ---- Flyer storage (optional) ----
# With these set, flyers go to Supabase Storage (create a PUBLIC bucket with this
# name first). Leave blank to keep flyers on the VPS in the "uploads" volume.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=event-media

# ---- Payments ----
# "test" until the WiPay account is approved: checkout is simulated, the site
# shows a test-mode banner, and no money moves. Don't sell real tickets in test mode.
PAYMENT_PROVIDER=test
ORDER_HOLD_MINUTES=15

# ---- Ticket emails (optional) ----
# Any SMTP provider (Resend, Postmark, Brevo, Gmail app password...). Blank = no emails;
# buyers still get their ticket link on screen and can share it on WhatsApp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Lehwi Palance <tickets@example.tt>
SMTP_STARTTLS=true
