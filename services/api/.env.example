# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://lehwi:lehwi@db:5432/lehwi
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Payments (WiPay). Card entry happens on WiPay's hosted page only.
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=sandbox
WIPAY_CALLBACK_URL=http://localhost:8000/v1/payments/wipay/callback
