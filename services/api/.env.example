# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://lehwi:lehwi@db:5432/lehwi
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PUBLIC_BASE_URL=http://localhost:5173

# Payments. "test" simulates checkout (no money moves) until WiPay is wired in.
PAYMENT_PROVIDER=test
ORDER_HOLD_MINUTES=15
# WiPay. Card entry happens on WiPay's hosted page only.
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=sandbox
WIPAY_CALLBACK_URL=http://localhost:8000/v1/payments/wipay/callback

# Flyers: Supabase Storage if set, else local disk at UPLOAD_DIR (served at /uploads).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=event-media
UPLOAD_DIR=/srv/uploads

# Ticket emails (optional).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Lehwi Palance <tickets@example.com>
